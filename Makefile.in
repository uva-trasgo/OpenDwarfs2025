	-rm -f spectral-methods/fft/src/opencl/fft/$(DEPDIR)/clfft-fft.Po
	-rm -f spectral-methods/fft/src/opencl/fft/$(DEPDIR)/clfft-fftlib.Po
	-rm -f structured-grids/srad/$(DEPDIR)/srad.Po
	-rm -f unstructured-grids/cfd/$(DEPDIR)/cfd.Po
	-rm -f Makefile
